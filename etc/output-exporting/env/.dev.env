ENV=development

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=output-exporting
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

SENTRY_ENABLED=False
SENTRY_DSN=

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps

# kafka
KAFKA_GROUP_ID=output-exporting

# Auth
AUTH_VERIFY_SSL=false

FILE_STORAGE_URL=http://deps-file-storage:8004
EXTRACTION_URL=http://deps-extraction:8000
DOCUMENT_TYPE_URL=http://deps-document-type:8000
DOCUMENT_URL=http://deps-document-api:8000
UNIFIER_URL=http://deps-unifier:8000
VALIDATION_URL=http://deps-validation-api:8000
HIGH_SPARROW_URL=http://deps-high-sparrow:8000
PARSING_URL=http://deps-parsing:8000
PROMPTER_URL=http://deps-prompter:8000

ONE_DRIVE_SCOPES=["https://graph.microsoft.com/.default"]
ONE_DRIVE_BASE_URL=https://graph.microsoft.com/v1.0
ONE_DRIVE_AUTHORITY_PREFIX=https://login.microsoftonline.com

SALESFORCE_BASE_URL=https://my-domain-name.my.salesforce.com
SALESFORCE_AUTH_ENDPOINT=/services/oauth2/token
SALESFORCE_UPLOAD_ENDPOINT=/services/data/v60.0/sobjects/ContentVersion

KVS_OUTPUT_ENABLED=false

CRYPT_CREDENTIALS_KEY=ePso8Hwb_XP2FEORW8Re-dJLfE_SvQwOZnTGUl1X94M=

# Feature flags
NEW_VALIDATION_PROCESS=false

# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=deps-output-exporting
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://deps-otlp:4317
OTLP_TRACE_ENDPOINT=http://deps-otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=connection_string
